---
import { funcionamiento } from "../../data";
---

<section
  id="funcionamiento"
  class="w-90/100 mx-auto text-[#1C244B] pt-10 md:pt-20 -mb-60"
>
  <div class="space-y-3 text-center mb-10">
    <span class="uppercase">Funcionamiento</span>

    <h2 class="font-archivo text-4xl font-light">
      <span class="font-bold border-b-2 border-[#FF7C00]">
        Diseño inteligente
      </span>
      de Filtración y Limpieza Automatizada
    </h2>
  </div>

  <div class="text-white flex flex-col md:flex-row gap-10">
    {
      funcionamiento.map(({ images, title, text1, text2 }) => (
        <div class="bg-card-funcionamiento p-10 rounded-4xl w-full md:w-1/2 md:space-y-0 space-y-5">
          <div class="swiper mySwiper2">
            <div class="swiper-wrapper">
              {images.map((img) => (
                <div class="swiper-slide">
                  <div class="w-full md:h-100 h-80 mb-5">
                    <img class="w-full h-full object-cover rounded-4xl" src={img} loading="lazy" alt={title} />
                  </div>
                </div>
              ))}
            </div>
          </div>

          <div class="space-y-3">
            <h3 class="text-3xl font-bold">{title}</h3>
            <p>{text1}</p>
            <p>{text2}</p>
          </div>
        </div>
      ))
    }
  </div>
</section>

<style>
  .swiper {
    width: 100%;
  }
</style>

<script type="module">
  import Swiper from "https://cdn.jsdelivr.net/npm/swiper@12/swiper-bundle.min.mjs";

  let swiper = new Swiper(".mySwiper2", {
    slidesPerView: 1,
    spaceBetween: 30,
    loop: true,
    autoplay: {
      delay: 4000,
    },
  });
</script>
